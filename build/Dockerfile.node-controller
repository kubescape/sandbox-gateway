FROM --platform=$BUILDPLATFORM golang:1.27.4-trixie AS builder

ENV GO111MODULE=on CGO_ENABLED=0
WORKDIR /work
ARG TARGETOS TARGETARCH

RUN --mount=target=. \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/node-controller -ldflags="-s -w" ./cmd/node-controller

FROM gcr.io/distroless/static-debian13:latest

COPY --from=builder /out/node-controller /usr/bin/node-controller

ARG image_version
ENV RELEASE=$image_version

ENTRYPOINT ["node-controller"]
