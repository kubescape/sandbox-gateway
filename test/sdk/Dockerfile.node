# The Node SDK client for the SDK job (test/integration/run.sh with SDK=1).
# s4_sdks.mjs fetches through undici with the gateway CA as its only root.
FROM node:22-slim
WORKDIR /sdk
RUN npm init -y >/dev/null && npm install --save-exact @anthropic-ai/sdk@1.6.0 openai@7.53.0 undici@7.30.2
COPY test/sdk/s4_sdks.mjs ./
ENV GATEWAY_CA=/certs/ca.crt
CMD ["node", "s4_sdks.mjs"]
